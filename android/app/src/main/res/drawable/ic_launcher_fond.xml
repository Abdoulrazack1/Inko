<?xml version="1.0" encoding="utf-8"?>
<!--
  Fond de l'icone adaptative.

  ⚠ Le nom compte. Ce fichier s'appelait `ic_launcher_background.xml`, alors
  qu'un `<color name="ic_launcher_background">` heritee de Capacitor vivait
  aussi dans values/. Deux ressources, le meme nom, deux types : `@drawable/`
  et `@color/` sont bien distincts pour Android, mais l'ambiguite ne sert a
  rien et rend indechiffrable ce que la chaine de construction a reellement
  retenu. Le doute est leve par le nom.

  VECTORIEL, pas une image : une icone adaptative est redimensionnee par le
  lanceur (et animee au survol sur certains), donc net a toute densite compte.
  Le degrade vient de assets/img/icon.svg, la source du logo.

  Plein cadre volontairement : c'est le LANCEUR qui masque les coins — cercle,
  carre arrondi, goutte selon le telephone. Dessiner nos propres coins ici
  produirait un double arrondi.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path android:pathData="M0,0h512v512h-512z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="512" android:endY="512"
                android:type="linear">
                <item android:offset="0" android:color="#FFFF7A59"/>
                <item android:offset="1" android:color="#FFE5354F"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
