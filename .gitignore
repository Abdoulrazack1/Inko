/node_modules/
# Backend
server/node_modules/
# Le .env de la RACINE alimente docker-compose (substitution de variables) ;
# celui de server/ alimente le serveur en dev. Les deux contiennent des secrets.
# Sans cette ligne, `setup-env.js` produisait un fichier commitable — c'est
# exactement le genre de fuite qu'on ne remarque qu'apres coup.
.env
.env.local
server/.env
server/.env.local
server/uploads/
server/backups/
server/config/google.json
server/config/anilist.json
server/config/vapid.json
server/config/secret.key
server/config/spotify.json
server/config/local-owner.json

# Extensions installées par l'utilisateur (modèle Mihon : aucune source en défaut)
# Les sources de référence sont dans extensions-community/.
server/extensions/*/
!server/extensions/loader.js
!server/extensions/README.md

# Desktop
desktop/node_modules/
desktop/dist/

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Build / Capacitor
# `android/` était ignoré EN ENTIER, vestige d'une tentative antérieure. Or le
# projet Android doit être versionné : c'est lui qui porte le manifeste, la
# configuration réseau et le niveau d'API. Sans lui dans le dépôt, la CI n'a
# rien à compiler. Seul ce que Gradle FABRIQUE est exclu, plus bas.
ios/
dist/
build/
# Retirer `android/` a dé-ignoré ces icônes, générées par `tauri icon` pour une
# plateforme que ce dépôt ne construit pas. L'ancienne règle les attrapait par
# effet de bord — on l'écrit maintenant explicitement.
desktop-tauri/src-tauri/icons/android/
desktop-tauri/src-tauri/icons/ios/

# Outils de prod vidéo (ffmpeg, puppeteer, frames) — lourds, hors repo
tools/

# Ressources d'icone desktop (source, a versionner)
!desktop/build/
!desktop/build/icon.*

# Playwright : traces et rapports d'échec (audit QUAL-03)
/test-results/
/playwright-report/
/blob-report/

# ── Application Android (audit P2.1) ──
# mobile/www est DÉRIVÉ : reconstruit par scripts-ci/build-mobile-www.js à
# chaque build. Le versionner ferait diverger deux copies du frontend, et
# c est exactement ce genre de duplication qui a produit un installeur sans
# aucune source en 2.5.1.
mobile/www/

# Le projet Android EST versionné (manifeste, gradle, configuration réseau)
# mais pas ce que Gradle fabrique.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

# Firebase : identifie le projet de CELUI qui construit l'APK, pas ce dépôt.
# Absent, `android/app/build.gradle` ignore simplement le greffon Google et la
# compilation aboutit — les notifications sont alors inactives, et le disent.
android/app/google-services.json

# Produits par scripts-ci/notes-release.js pendant une publication
RELEASE_NOTES.md
RELEASE_TITLE.txt
