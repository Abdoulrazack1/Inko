{
  "name": "inko",
  "version": "2.5.7",
  "private": true,
  "description": "Inko — lecteur de mangas et romans (frontend vanilla + backend Express dans server/)",
  "scripts": {
    "test": "node scripts-ci/run-unit-tests.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test test/e2e/a11y.spec.js",
    "lint": "eslint assets/js service-worker.js",
    "lint:fix": "eslint assets/js service-worker.js --fix",
    "gen-ext-hashes": "node scripts-ci/gen-ext-hashes.js",
    "check-sources": "node scripts-ci/check-sources.js",
    "gen-precache": "node scripts-ci/gen-precache.js",
    "gen-repli-ar": "node scripts-ci/gen-repli-aspect-ratio.js",
    "verifier-installeur": "node scripts-ci/verifier-installeur.js",
    "gen-openapi": "node scripts-ci/gen-openapi.js",
    "setup": "node scripts-ci/setup-env.js",
    "setup:check": "node scripts-ci/setup-env.js --check",
    "gen-meta": "node scripts-ci/gen-meta.js",
    "fetch-fonts": "node scripts-ci/fetch-fonts.js",
    "clean": "node scripts-ci/clean.js",
    "clean:all": "node scripts-ci/clean.js --all",
    "mobile:www": "node scripts-ci/build-mobile-www.js",
    "mobile:sync": "node scripts-ci/build-mobile-www.js && cap sync android",
    "verifier-apk": "node scripts-ci/verifier-apk.js",
    "verif-java": "node scripts-ci/verifier-java-android.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/device": "^7.0.5",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/network": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/screen-orientation": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6"
  }
}
