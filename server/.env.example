# ============================================================
# Inko — configuration serveur (copier vers .env et remplir)
#   cp .env.example .env
# Ne JAMAIS committer le fichier .env (il est gitignoré).
# ============================================================

# Serveur
PORT=8088
NODE_ENV=development
# Derrière un reverse-proxy (nginx, Caddy…) : TRUST_PROXY=1 rend req.ip fiable
# TRUST_PROXY=1

# En production : liste blanche CORS stricte (origines séparées par des virgules)
# CORS_ORIGINS=https://inko.exemple.com

# Rate limiting auth (défaut 12 échecs / 15 min / IP)
# AUTH_RATE_MAX=12

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inko

# Auth — OBLIGATOIRE en production (générer : openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES=30d

# Google Sign-In (optionnel — configurable aussi depuis l'app)
GOOGLE_CLIENT_ID=

# AniList (optionnel — configurable aussi depuis l'app)
ANILIST_CLIENT_ID=
ANILIST_REDIRECT_URI=http://127.0.0.1:8088/anilist.html


# Email transactionnel (mot de passe oublié) — audit S1
# Sans SMTP_HOST, le flux « mot de passe oublié » retombe en mode dev
# (token renvoyé au client). En production, configurer un SMTP réel :
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true si port 465 (SSL), false pour 587 (STARTTLS)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Inko <no-reply@exemple.com>
# APP_URL=https://inko.exemple.com   # base publique des liens envoyés par email
