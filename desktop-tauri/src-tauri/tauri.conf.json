{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inko",
  "version": "2.3.0",
  "identifier": "app.inko.reader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Inko",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/server": "resources/server",
      "resources/frontend": "resources/frontend",
      "resources/mariadb": "resources/mariadb"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
