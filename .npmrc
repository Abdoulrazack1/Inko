# `engines` seul n'est qu'un AVERTISSEMENT : npm installe quand même, et
# l'échec arrive bien plus tard, sous une forme incompréhensible. Constaté sur
# Node 20 après le passage à Capacitor 8 / jsdom 30 :
#
#   TypeError: webidl.util.markAsUncloneable is not a function
#
# Rien dans ce message ne dit « ta version de Node est trop ancienne ». Avec
# engine-strict, `npm install` s'arrête net en nommant la version requise.
engine-strict=true
